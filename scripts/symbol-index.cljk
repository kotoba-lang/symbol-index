#!/usr/bin/env kbb
;; シンボル索引: .cljk / .cljc / .cljs / .clj / .kotoba を走査し、
;; (def...) / (ns...) の top-level form に現れるシンボルから
;; 「シンボル → file:line」の索引を作る。
;;
;; なぜ必要か。2026-09-15 の Co-Scientist iteration 1 で実測した:
;;
;;   * コード理解のための full-file read は 1 query あたり平均 ~6,580 tok
;;     (p50 2,212 tok)。シンボル位置 + 前後 3 行の snippet なら平均 ~122 tok。
;;     **54 倍の差**。hyakka/catalog.cljk (1.28M tok) のような file を
;;     full read すると context が破綻する。
;;   * superproject root の `git grep` は子 repo (gitlink) を 1 件も引かない
;;     (実測 0 hit)。rg なら 424 MB 走査が 3.6s。
;;
;; そこで: **「コードを読む」前に、これを引く。**
;;
;;   kbb --backend sci scripts/symbol-index.cljk build          # 索引生成
;;   kbb --backend sci scripts/symbol-index.cljk find reconcile  # シンボル検索
;;   kbb --backend sci scripts/symbol-index.cljk show kagami.db/apply-pin-advance
;;                                                              # 定義の snippet 表示
;;   kbb --backend sci scripts/symbol-index.cljk outline kagami.db  # file/ns の定義一覧
;;   kbb --backend sci scripts/symbol-index.cljk status         # 索引の素性
;;
;; 索引は .kotoba-cache/symbol-index.tsv (v2) に落ちる。iteration 2 (2026-09-15)
;; で JSON + js->clj (108 MB, 5.5 s/query) を捨て、TSV を native RegExp で
;; 走査する形にした (measurements.edn に実測)。
;;
;; exit code は 3 値: 0 = hit / 1 = 測って 0 件 (grep 規約) / 2 = 答えを拒否
;; (無引数・未知 cmd・索引が空・索引の top が cwd と違う・show の不在 symbol)。
;; 「測れなかった」と「測って無かった」を同じ値にしない。

(require '[clojure.string :as str])

(def fs (js/require "node:fs"))
(def path (js/require "node:path"))

(def index-dir ".kotoba-cache")
(def index-file "symbol-index.tsv")
(def index-version "v2")

(defn- nearest-indexed-ancestor
  "cwd から上へ辿って .kotoba-cache/symbol-index.tsv を持つ最初の dir。無ければ nil。
  agent の shell は project root に居ないことが多い (Hermes Agent の terminal は
  $HOME で始まる実測、2026-09-15) ので、cwd 決め打ちにしない。"
  [start]
  (loop [d start]
    (if (.existsSync fs (.join path d index-dir index-file))
      d
      (let [up (.dirname path d)]
        (if (= up d) nil (recur up))))))

(def top
  "索引の root。優先順: SYMBOL_INDEX_ROOT > CLAUDE_PROJECT_DIR > 索引を持つ最寄りの
  祖先 dir > cwd。cwd に落ちるのは build のときだけ意味がある (find/show は索引が
  無ければ拒否する —— 以前は $HOME で呼ばれて home 全体を走査し、Hermes の terminal
  tool の 120s timeout に当たった)。"
  (let [chosen (or (not-empty (.-SYMBOL_INDEX_ROOT (.-env js/process)))
                   (not-empty (.-CLAUDE_PROJECT_DIR (.-env js/process)))
                   (nearest-indexed-ancestor (.cwd js/process))
                   (.cwd js/process))]
    ;; header の top と文字列比較するので realpath に揃える (macOS の /var → /private/var、
    ;; env で symlink 側の path を渡された場合に top 不一致で拒否していた実測)。
    (try (.realpathSync fs chosen) (catch :default _ chosen))))

(def ^:private scan-exts #{".cljk" ".cljc" ".cljs" ".clj" ".kotoba"})
(def ^:private skip-dirs #{".git" "node_modules" ".west" "target" ".cpcache" ".lsp" ".clj-kondo"
                           ".kotoba-cache" ".shadow-cljs" ".nbb" "dist" "build"})
(def ^:private max-file-bytes (* 4 1024 1024))
(def ^:private find-limit 40)

(def def-form-re
  "top-level 定義 form。sexp parser を持ち込まない代わりに、この家系の codebase は
  top-level def を行頭に置く規約で書かれている。iteration 2 で足した形:
    * 行頭 `#?(:clj (defn …` の inline reader conditional (実測 1,347 行)
    * 3 桁以内の浅い indent (`#?(:clj\\n   (defn …` / `(comment\\n  (defn …`、
      実測 3,393 行)。4 桁以上は test の文字列内 code が多いので取らない。
    * 名前の前の metadata `^:private` / `^{:doc \"…\"}` / `^String` を読み飛ばす
      (iteration 1 では 38,894 件 = 5% が `^:private` という名前で索引に載った)。
  iteration 3: 行ごとでなく file 全文に `gm` で当てる native RegExp。SCI の
  per-line loop (5,000 file で 1,712 ms) が 387 ms になり、複数行に跨る
  `^{:doc \"…\"}\\n  name` の def (per-line では取れなかった) も名前と行を拾う。
  indent は `[ \\t]{1,3}` にする (`\\s` だと `^` の後の空行を跨いで誤る)。
  group 1 = reader-cond / indent の有無 (nested 判定)、2 = kind、3 = name。"
  (js/RegExp.
   (str "^((?:#\\?\\(:\\w+\\s+)|[ \\t]{1,3})?"
        "\\((defn|defn-|def|defonce|defmacro|defmulti|defmethod|defprotocol|defrecord|deftype|ns|deftest)"
        "\\s+(?:(?:\\^\\{[^}]*\\}|\\^\\S+)\\s+)*"
        "([^\\s\\^\\(\\)\\[\\]\\{\\}\"]+)")
   "gm"))

(defn- linked-worktree?
  "`.git` が **file** で `gitdir: …/.git/worktrees/<name>` を指す = git の linked
  worktree。主 checkout と同じ内容の写しなので既定では走査しない (submodule の
  gitfile は `.git/modules/…` を指すので該当しない)。名前 (`worktrees/`, `_wt-*`)
  ではなく実在する構造で判定する (itonami-maturity-scan の virtualenv? と同じ理由)。
  iteration 6: 子 dir ごとに `.git` を statSync していた (dir 数と同じ 74K 回) のを
  やめ、その dir を **読んだとき** の dirent (`.git` が file か) で判定する。
  git-entry は readdir が返した `.git` の Dirent か nil。"
  [dir git-entry]
  (boolean
   (and git-entry (.isFile git-entry)
        (try (str/includes? (.readFileSync fs (.join path dir ".git") "utf8") "/worktrees/")
             (catch :default _ false)))))

(defn- gitignored-children
  "top が git repo なら、top **直下** の entry のうち gitignore され、かつ自身が
  git repo でない (`.git` を持たない) ものの名前集合。生成物 dir (`runs/`
  `verify-runs/` 等、実測で 3.2 万 symbol) を索引から外す。west の子 repo は
  root の .gitignore に載っているが `.git` を持つので残る。深さ 2 以上は見ない
  (5,000 行の .gitignore に対する check-ignore が depth 2 で 30 s、depth 1 で
  0.85 s と測ったため)。git が無い / top が repo でない → 空集合 (skip 0 は
  「何も無い」ではなく「測っていない」なので stats に :gitignore-checked を残す)。"
  []
  (if-not (.existsSync fs (.join path top ".git"))
    {:names #{} :checked false}
    (try
      (let [cp (js/require "node:child_process")
            names (remove #{".git"} (js->clj (.readdirSync fs top)))
            out (.execFileSync cp "git" #js["check-ignore" "--stdin"]
                               #js{:cwd top :input (str (str/join "\n" names) "\n")
                                   :encoding "utf8" :stdio #js["pipe" "pipe" "ignore"]})
            ignored (remove str/blank? (str/split-lines out))]
        {:checked true
         :names (into #{} (remove #(.existsSync fs (.join path top % ".git"))) ignored)})
      ;; check-ignore は 1 件も ignore が無いと exit 1 で throw する。それ以外
      ;; (git 不在 / exit 128) は「測れなかった」なので checked false。
      (catch :default e {:names #{} :checked (= 1 (.-status e))}))))

(def ^:private prune-budget
  "group (repo 直下 2 段、repo 外は top から 4 段) の中で **連続して** source file を
  1 つも持たない dir がこの数に達したら、その group の残りを歩かない。
  iteration 4 の実測 (root corpus、136,302 dir): source を持つ group の最長 fileless
  run は 737 (`etzhayyim/root/50-infra/etzhayyim-did-web`)、fileless な group の dir
  は 116,269。budget 800 で誤爆 0 / 62,447 dir を prune、1000 は余裕 36%。
  prune した group は header の pruned-groups と `status` に必ず載る (黙って
  消さない)。`build --no-prune` で無効。"
  1000)

(defn- group-of
  "prune の集計単位。repo (`.git` を持つ最寄りの祖先) の中なら repo path + 直下 2 段、
  repo の外なら top 相対 4 段。1 段だと `50-infra` (1,362 run の後に 86 file) を
  誤爆し、2 段なら誤爆 0 だった (measurements.edn :h13)。"
  [rel repo]
  (if repo
    (let [segs (remove str/blank? (str/split (subs rel (count repo)) #"/"))]
      (if (seq segs) (str repo "/" (str/join "/" (take 2 segs))) repo))
    (str/join "/" (take 4 (str/split rel #"/")))))

(def cache-file "symbol-index.cache.json")

(defn- cache-path [] (.join path top index-dir cache-file))

(defn- load-cache
  "前回 build の sidecar cache (JSON、native parse)。無い / 読めない / top 違い / --full
  は空。形: {\"v\" \"top\" \"dirs\" {rel {\"m\" mtimeMs \"e\" [[name kind link?] ...] \"w\" worktree?}}
  \"files\" {rel {\"m\" mtimeMs \"s\" size \"n\" rows \"r\" rows-text}}}。
  iteration 7: 日次 rebuild で変わる file は僅かなのに毎回 51K file を読み 74K dir を
  readdir していた。dir は mtime (entry の増減で変わる)、file は mtime+size で
  変化を判定し、変わっていなければ readdir / read を省く。同一 ms・同一 size の
  書き換えは見えない (--full で全読み)。"
  [opts]
  (if (:full opts)
    nil
    (try
      (let [c (.parse js/JSON (.readFileSync fs (cache-path) "utf8"))]
        (when (and (= (aget c "v") index-version) (= (aget c "top") top)) c))
      (catch :default _ nil))))

(defn- dir-entries
  "dir を読む。cache の mtime が一致すれば cache の entry 列 (readdir も link の stat も
  無し)。返り値 {:entries [[name kind link?] ...] :cached? bool :mtime ms :wt bool}
  kind は \"f\" / \"d\" / \"\"。読めない dir は :unreadable true。"
  [d rel cache]
  (let [m (try (.-mtimeMs (.statSync fs d)) (catch :default _ nil))
        hit (when (and m cache) (aget (aget cache "dirs") rel))]
    (if (and hit (= (aget hit "m") m))
      {:entries (js->clj (aget hit "e")) :cached? true :mtime m :wt (boolean (aget hit "w"))}
      (let [raw (try (.readdirSync fs d #js{:withFileTypes true})
                     (catch :default _ ::unreadable))]
        (if (= raw ::unreadable)
          {:entries [] :cached? false :mtime m :wt false :unreadable true}
          (let [entries (mapv (fn [e]
                                (let [name (.-name e) link? (.isSymbolicLink e)
                                      [file? dir?] (if link?
                                                     (let [st (try (.statSync fs (.join path d name)) (catch :default _ nil))]
                                                       (if st [(.isFile st) (.isDirectory st)] [false false]))
                                                     [(.isFile e) (.isDirectory e)])]
                                  [name (cond file? "f" dir? "d" :else "") link?]))
                              raw)
                git (some (fn [[name kind]] (when (= name ".git") kind)) entries)
                wt (boolean (and (= git "f")
                                 (try (str/includes? (.readFileSync fs (.join path d ".git") "utf8") "/worktrees/")
                                      (catch :default _ false))))]
            {:entries entries :cached? false :mtime m :wt wt}))))))

(defn- walk
  "dir 配下の走査対象 file を返す。west の子 repo は symlink checkout なので
  symlink の **指先** を辿る。visited set (realpath) で symlink loop を断つ。

  iteration 2: 返す path は **realpath** にする。iteration 1 は symlink 側の path
  を返していたので `worktrees/kotoba-lang/kagami/...` が先に踏まれると正本の
  `orgs/kotoba-lang/kagami/...` が索引から消えた (実測: apply-pin-advance が
  worktrees/ 側 1 件のみ)。

  iteration 3: readdirSync withFileTypes で dirent の種別を使い、statSync は
  symlink のときだけ、realpathSync は symlink か symlink 配下 (aliased) のとき
  だけ呼ぶ (同一 tree で 67 s → 46 s)。⚠ Node Stats / Dirent の isFile 等は
  method — (.-isFile e) は関数が返るだけで真偽にならない。読めない dir
  (EACCES / ENAMETOOLONG、実測: 名前が shell script 全文の dir が在った) は
  落とさず :unreadable-dirs に数える。

  iteration 4: dir の 76% (105K/136K) は source を 1 つも持たない subtree
  (takeout / news resources / onedrive archive / .venv) だった。名前でなく
  「連続 fileless dir 数」で prune し (prune-budget)、`pyvenv.cfg` を持つ dir は
  virtualenv として歩かない。

  iteration 7: dir ごとに statSync 1 回で mtime を見て、cache と一致すれば readdir を
  省く (dir-entries)。歩いた dir は new-cache に記録して build の最後に書く。
  返り値は {:files [...] :stats {...} :dir-cache #js{}}。"
  [dir opts cache]
  (let [out (volatile! [])
        seen-files (volatile! #{})
        visited (volatile! #{})
        {ignored :names checked :checked} (gitignored-children)
        budget (if (:no-prune opts) js/Infinity prune-budget)
        runs (volatile! {})            ; group -> 連続 fileless dir 数
        pruned (volatile! #{})         ; 打ち切った group
        dir-cache #js{}
        stats (volatile! {:dirs 0 :stat-dirs 0 :cached-dirs 0 :pruned-dirs 0 :unreadable-dirs 0 :skipped-worktrees 0 :skipped-venvs 0
                          :skipped-gitignored (count ignored)
                          :gitignore-checked checked})
        realpath (fn [p] (try (.realpathSync fs p) (catch :default _ p)))]
    ;; queue entry = [path realpath repo]; repo = 最寄りの祖先 repo の top 相対 path
    (loop [dirs [[dir (realpath dir) nil]]]
      (if-let [[d dreal repo] (first dirs)]
        (let [;; ⚠ (rest dirs) は seq なので conj は先頭に積む = DFS になる (iteration 2-3
              ;; はそうなっていた)。prune の budget は BFS で校正したので vec にして末尾に積む。
              next-dirs (volatile! (vec (rest dirs)))
              at-top? (= d dir)
              aliased? (not= d dreal)
              rel (if at-top? "" (subs d (inc (count dir))))]
          (when-not (contains? @visited dreal)
            (vswap! visited conj dreal)
            ;; prune 済み group の dir は readdir しない: 親から継いだ repo で group を出し、
            ;; その dir 自身が repo (.git を持つ) でなければ stat 1 回で打ち切る (nested repo
            ;; は prune の外に出す = iteration 4 と同じ挙動)。
            (if (and (contains? @pruned (group-of rel repo))
                     (not (.existsSync fs (.join path d ".git"))))
              (vswap! stats update :pruned-dirs inc)
            (let [{:keys [entries cached? mtime wt unreadable]} (dir-entries d rel cache)
                  names (into #{} (map first) entries)
                  repo (if (and (seq rel) (contains? names ".git")) rel repo)
                  group (group-of rel repo)]
              (vswap! stats update :stat-dirs inc)
              (when unreadable (vswap! stats update :unreadable-dirs inc))
              (when cached? (vswap! stats update :cached-dirs inc))
              (when mtime
                (aset dir-cache rel #js{:m mtime :w wt :e (clj->js entries)}))
              (cond
                (contains? @pruned group) nil
                ;; top 自身が linked worktree でも歩く (agent の作業は worktree 内が標準。
                ;; iteration 6 で top も skip して SCANNED 0 になる regression を test が掴んだ)
                (and (not at-top?) (not (:include-worktrees opts)) wt)
                (vswap! stats update :skipped-worktrees inc)
                (contains? names "pyvenv.cfg") (vswap! stats update :skipped-venvs inc)
                :else
                (let [found (volatile! false)]
                  (vswap! stats update :dirs inc)
                  (doseq [[name kind link?] entries]
                    (when-not (or (contains? skip-dirs name)
                                  (and at-top? (contains? ignored name)))
                      (let [full (.join path d name)]
                        (cond
                          (and (= kind "f") (contains? scan-exts (.extname path name)))
                          (let [rf (if (or link? aliased?) (realpath full) full)]
                            (vreset! found true)
                            (when-not (contains? @seen-files rf)
                              (vswap! seen-files conj rf)
                              (vswap! out conj rf)))
                          (= kind "d")
                          (vswap! next-dirs conj [full (if (or link? aliased?) (realpath full) full) repo])
                          :else nil))))
                  (if @found
                    (vswap! runs assoc group 0)
                    (let [n (inc (get @runs group 0))]
                      (vswap! runs assoc group n)
                      (when (>= n budget) (vswap! pruned conj group)))))))))
          (recur @next-dirs))
        :done))
    {:files @out :stats (assoc @stats :pruned-groups (sort @pruned)) :dir-cache dir-cache}))

(defn- rel-path [full]
  (if (str/starts-with? full (str top "/"))
    (subs full (inc (count top)))
    full))

(defn- scan-file
  "1 file から TSV 行 (sym<TAB>kind<TAB>file<TAB>line<TAB>ns<TAB>flags) の列を返す。
  `(ns …)` を跨ぐごとに ns を持ち替え、後続の def にその ns を付ける (show の ns/sym
  曖昧性解消に使う)。行番号は match の index までの改行を数えて出す (前回 match から
  差分で数える)。iteration 7: map でなく行文字列を返す (cache にそのまま入る)。"
  [full rel]
  (let [text (.readFileSync fs full "utf8")
        ns* (volatile! "")
        out (volatile! [])]
    (set! (.-lastIndex def-form-re) 0)
    (loop [line 1 from 0]
      (when-let [m (.exec def-form-re text)]
        (let [;; 行は `(def` の位置で数える。group 1 が `#?(:clj\n   ` のとき match は
              ;; 前の行から始まるので、その長さ分ずらす (iter2 と同じ行に揃える)
              idx (+ (.-index m) (count (or (aget m 1) "")))
              ;; from..idx の改行数を native indexOf で数える
              line (loop [l line i (.indexOf text "\n" from)]
                     (if (or (neg? i) (>= i idx)) l (recur (inc l) (.indexOf text "\n" (inc i)))))
              kind (aget m 2) sym (aget m 3) nested (some? (aget m 1))]
          (when (= kind "ns") (vreset! ns* sym))
          (vswap! out conj (str sym "\t" kind "\t" rel "\t" line "\t" (if (= kind "ns") sym @ns*) "\t" (if nested "n" "")))
          (recur line idx))))
    @out))

(defn- build-index
  "全対象 file から TSV 行の列 (file ごとの block) と走査統計を作る。統計は evidence
  floor: SCANNED が 0 の索引は書かない (「空の tree」と「top を間違えた」を pass に
  混ぜない)。iteration 7: file は statSync で (mtime, size) を見て cache と一致すれば
  前回の行をそのまま使う (read も regex も無し)。返り値の :blocks は file ごとの
  行文字列 (改行結合済み)、:symbols は行数。"
  [opts]
  (let [cache (load-cache opts)
        {:keys [files stats dir-cache]} (walk top opts cache)
        cfiles (when cache (aget cache "files"))
        file-cache #js{}
        blocks (volatile! [])
        nsyms (volatile! 0)
        st (volatile! (assoc stats :scanned 0 :cached-files 0 :skipped-size 0 :unreadable 0))]
    (doseq [full files]
      (let [rel (rel-path full)]
        (try
          (let [fst (.statSync fs full) m (.-mtimeMs fst) size (.-size fst)
                hit (when cfiles (aget cfiles rel))]
            (if (<= size max-file-bytes)
              (let [[n text] (if (and hit (= (aget hit "m") m) (= (aget hit "s") size))
                               (do (vswap! st update :cached-files inc) [(aget hit "n") (aget hit "r")])
                               (let [rows (scan-file full rel)] [(count rows) (str/join "\n" rows)]))]
                (vswap! st update :scanned inc)
                (vswap! nsyms + n)
                (aset file-cache rel #js{:m m :s size :n n :r text})
                (when (pos? n) (vswap! blocks conj text)))
              (vswap! st update :skipped-size inc)))
          (catch :default _ (vswap! st update :unreadable inc)))))
    {:blocks @blocks :symbols @nsyms :stats @st
     :cache #js{:v index-version :top top :dirs dir-cache :files file-cache}}))

;; ---------------------------------------------------------------- TSV v2
;; header: #symbol-index<TAB>v2<TAB>key=value ...
;; row:    sym<TAB>kind<TAB>file<TAB>line<TAB>ns<TAB>flags   (flags: "" | "n")

(defn- index-path [] (.join path top index-dir index-file))

(defn- write-index
  [{:keys [blocks symbols stats cache]}]
  (let [dir (.join path top index-dir)
        header (str "#symbol-index\t" index-version
                    "\ttop=" top
                    "\tbuilt-at=" (.toISOString (js/Date.))
                    "\tscanned=" (:scanned stats)
                    "\tskipped-size=" (:skipped-size stats)
                    "\tskipped-worktrees=" (:skipped-worktrees stats)
                    "\tskipped-gitignored=" (:skipped-gitignored stats)
                    "\tgitignore-checked=" (:gitignore-checked stats)
                    "\tunreadable=" (:unreadable stats)
                    "\tunreadable-dirs=" (:unreadable-dirs stats)
                    "\tskipped-venvs=" (:skipped-venvs stats)
                    "\tpruned=" (count (:pruned-groups stats))
                    "\tpruned-groups=" (str/join ";" (:pruned-groups stats))
                    "\tcached-dirs=" (:cached-dirs stats)
                    "\tcached-files=" (:cached-files stats)
                    "\tsymbols=" symbols)]
    (when-not (.existsSync fs dir)
      (.mkdirSync fs dir #js{:recursive true}))
    (.writeFileSync fs (index-path) (str header "\n" (str/join "\n" blocks) "\n") "utf8")
    ;; sidecar cache は索引の後に書く (索引だけ在って cache が無い状態は許容、逆は不可)
    (.writeFileSync fs (cache-path) (.stringify js/JSON cache) "utf8")))

(defn- parse-header
  "先頭行を {:version :top :scanned :symbols ...} に。v1 (JSON) や壊れた先頭は nil。"
  [text]
  (let [nl (.indexOf text "\n")
        line (if (neg? nl) text (subs text 0 nl))
        [tag version & kvs] (str/split line #"\t")]
    (when (= tag "#symbol-index")
      (into {:version version}
            (map (fn [kv] (let [i (.indexOf kv "=")]
                            [(keyword (subs kv 0 i)) (subs kv (inc i))])))
            kvs))))

(defn- parse-row [line]
  (let [[sym kind file ln ns flags] (str/split line #"\t")]
    {:sym sym :kind kind :file file :line (js/parseInt ln 10) :ns (or ns "")
     :nested (= flags "n")}))

(defn- refuse
  "拒否は理由を印字して 2 を返す。理由の literal は test が pin する。"
  [& msg]
  (println (str "REFUSE\t" (apply str msg)))
  2)

(defn- do-build [opts]
  (let [{:keys [symbols stats] :as built} (build-index opts)]
    (println (str "SCANNED\t" (:scanned stats)))
    (println (str "SKIPPED-SIZE\t" (:skipped-size stats)))
    (println (str "SKIPPED-WORKTREES\t" (:skipped-worktrees stats)))
    (println (str "SKIPPED-GITIGNORED\t" (:skipped-gitignored stats)
                  (if (:gitignore-checked stats) "" "\t(not checked: no git or top is not a repo)")))
    (println (str "UNREADABLE\t" (:unreadable stats)))
    (println (str "UNREADABLE-DIRS\t" (:unreadable-dirs stats)))
    (println (str "SKIPPED-VENVS\t" (:skipped-venvs stats)))
    (println (str "CACHED-DIRS\t" (:cached-dirs stats) "\tof " (:stat-dirs stats)
                  (if (:full opts) "\t(--full: cache ignored)" "")))
    (println (str "CACHED-FILES\t" (:cached-files stats) "\tof " (:scanned stats)))
    (println (str "PRUNED-DIRS\t" (:pruned-dirs stats) "\t(queued under a pruned group; 1 stat each, no readdir)"))
    (println (str "PRUNED\t" (count (:pruned-groups stats))
                  (when (seq (:pruned-groups stats))
                    (str "\t(" prune-budget " consecutive dirs without source; see `status`, or build --no-prune)"))))
    (if (zero? (:scanned stats))
      (refuse "scanned 0 files under " top " — empty tree or wrong top (set CLAUDE_PROJECT_DIR or cd)")
      (do (write-index built)
          (println (str "indexed " symbols " symbols -> " index-dir "/" index-file))
          0))))

(defn- load-index-text
  "索引の本文 (TSV 全文) と header を返す。無い / top 不一致 / 空 / 旧形式は
  {:error …} を返す (呼び側が refuse する)。**無くても build を代行しない** ——
  top が $HOME に落ちた状態で呼ばれると home 全体を走査して timeout する
  (Hermes Agent で実測)。build は明示の `build` だけ。"
  []
  (let [p (index-path)]
    (if-not (.existsSync fs p)
      {:error (str "no index at " p " — run `symbol-index build` at the project root (or set SYMBOL_INDEX_ROOT)")}
      (let [text (.readFileSync fs p "utf8")
            h (parse-header text)]
        (cond
          (nil? h) {:error "index is not v2 TSV (stale JSON?) — run build"}
          (not= (:top h) top) {:error (str "index was built for top=" (:top h) " but cwd top=" top " — run build here")}
          (= "0" (:symbols h)) {:error (str "index has 0 symbols (scanned " (:scanned h) " files) — run build")}
          :else {:header h :text text})))))

(defn- escape-re [s]
  (str/replace s #"[.*+?^${}()|\[\]\\/]" "\\$&"))

(defn- scan-rows
  "TSV 本文を native RegExp で走査し、当たった行だけ parse する。SCI の per-line
  loop を回さないのが iteration 2 の速度の源 (5.5 s → 実測は measurements.edn)。
  sym-pattern は sym 列に対する正規表現の断片、flags は RegExp flags。"
  [text sym-pattern flags]
  (let [re (js/RegExp. (str "^" sym-pattern "\\t[^\\n]*$") (str "gm" flags))
        out (volatile! [])]
    (loop []
      (when-let [m (.exec re text)]
        (vswap! out conj (parse-row (aget m 0)))
        (recur)))
    @out))

(defn- age-warning
  "索引が 24 h より古ければ 1 行だけ言う。自動 rebuild はしない (2 分かかる判断を
  黙って agent に肩代わりさせない)。"
  [header]
  (let [ms (- (.getTime (js/Date.)) (.getTime (js/Date. (:built-at header))))]
    (when (> ms (* 24 3600 1000))
      (println (str "  (index is " (js/Math.round (/ ms 3600000)) " h old — `build` if you edited code since)")))))

(defn- rank-key
  "exact < prefix < substring、同点は top-level が nested より先、次に path。"
  [term-lower {:keys [sym nested file]}]
  (let [s (str/lower-case sym)]
    [(cond (= s term-lower) 0 (str/starts-with? s term-lower) 1 :else 2)
     (if nested 1 0)
     (count file)
     file]))

(defn- fmt-hit
  [{:keys [sym kind file line nested copies]}]
  (str "  " (if nested "~" "") kind " " sym " — " file ":" line
       (when (and copies (pos? copies)) (str "  (+" copies " copies)"))))

(defn- snippet
  "file の line の 1 行前から、定義の冒頭 after 行 (既定 6) を返す。iteration 7 で
  前後対称 (±3) から前 1 / 後 6 に変えた: agent の問いは「定義の冒頭を見せて」で、
  def 行の *前* の 3 行は docstring でも本体でもない (Hermes A/B の 8 query 全部が
  find の後に show か read_file をもう 1 回呼んでいた)。"
  [file line & [after]]
  (let [after (or after 6)
        full (.join path top file)]
    (try
      (let [lines (str/split-lines (.readFileSync fs full "utf8"))
            from (max 0 (- line 2))
            to (min (count lines) (+ line after))]
        (str/join "\n" (map #(str "  " (inc %) "| " (nth lines %))
                            (range from to))))
      (catch :default _ "  (unreadable)"))))

(defn- repo-of
  "hit の repo 相当 (path の先頭 3 段、`orgs/<org>/<repo>`; 浅い path はそのまま)。"
  [file]
  (let [segs (str/split file #"/")]
    (if (>= (count segs) 4)
      (str/join "/" (take 3 segs))
      (str/join "/" (butlast segs)))))

(defn- suggest-near
  "0 hit のときの近傍: term を - / _ / . で割った 4 文字以上の断片ごとに substring で
  引き、symbol 名を最大 8 個返す。Hermes A/B の baseline 誤答は 4/4 が『定義は存在
  しない』型の false negative だった — 0 hit を『無い』と読ませない。"
  [text term keep?]
  (let [parts (->> (str/split term #"[-_./]")
                   (mapcat (fn [p] [p (when (> (count p) 5) (subs p 0 5))]))
                   (remove nil?) (filter #(>= (count %) 4)) distinct)
        near (->> parts
                  (mapcat #(scan-rows text (str "[^\\t\\n]*" (escape-re %) "[^\\t\\n]*") "i"))
                  (filter keep?)
                  (map :sym) distinct (take 8))]
    (when (seq near)
      (println (str "  near (by fragment " (str/join "," parts) "): " (str/join " " near)))
      (println "  → find <one of them>   (0 hits is not 'undefined'; symbols may be spelled differently)"))))

(defn- cmd-find
  "term [term...] [--in <path-substr>] [--exact]。term が `ns/sym` なら leaf で引いて ns 列で絞る。
  hit が find-limit を超えたら substring hit を垂れ流さず、exact/prefix hit + repo ごとの
  件数表を出して次の 1 手 (--in / --exact) を示す (iteration 8)。"
  [args]
  (let [{:keys [header text error]} (load-index-text)]
    (if error
      (refuse error)
      (let [in-idx (.indexOf (to-array args) "--in")
            in-filter (when (and (>= in-idx 0) (< (inc in-idx) (count args))) (nth args (inc in-idx)))
            exact? (some #{"--exact"} args)
            terms (->> args (remove #{"--exact"}) (remove #{"--in"}) (remove #{in-filter}))
            split-ns (fn [t] (let [i (.lastIndexOf t "/")] (if (pos? i) [(subs t 0 i) (subs t (inc i))] [nil t])))
            leafs (map (comp second split-ns) terms)
            nss (keep (comp first split-ns) terms)
            keep? (fn [h] (and (or (empty? nss) (some (fn [n] (= n (:ns h))) nss))
                               (or (nil? in-filter) (str/includes? (:file h) in-filter))))
            hits (->> leafs
                      (mapcat #(scan-rows text (if exact? (escape-re %) (str "[^\\t\\n]*" (escape-re %) "[^\\t\\n]*")) "i"))
                      distinct
                      (filter keep?))
            term0 (str/lower-case (first leafs))
            ;; 同じ定義の写し (同 sym/kind/line/basename、verify-run や clone の copy) は 1 行に
            ;; 畳み、最短 path を代表にして :copies に残りの数を持つ (iteration 9)
            ranked (->> (sort-by #(rank-key term0 %) hits)
                        ;; 拡張子は見ない: .clj → .cljk の rename 前の写しも同じ定義
                        (group-by (fn [{:keys [sym kind line file]}] [sym kind line (.basename path file (.extname path file))]))
                        vals
                        (map (fn [grp] (assoc (first grp) :copies (dec (count grp)))))
                        (sort-by #(rank-key term0 %)))
            n (count ranked)
            exact (filter #(zero? (first (rank-key term0 %))) ranked)]
        (println (str "indexed " (:symbols header) " symbols, " n " hits for " (str/join " " terms)
                      (when (> (count hits) n) (str " (" (- (count hits) n) " copies folded)"))
                      (when in-filter (str " --in " in-filter)) (when exact? " --exact")))
        (age-warning header)
        (if (<= n find-limit)
          (doseq [h ranked] (println (fmt-hit h)))
          (let [n-exact (count exact)
                repos (map (comp repo-of :file) ranked)
                by-repo (->> repos frequencies (sort-by (comp - val)) (take 12))]
            (println (str "  too many to list: " n-exact " exact, " (- n n-exact) " substring, in "
                          (count (distinct repos)) " repos. Top repos:"))
            (doseq [[r c] by-repo] (println (str "  " c "\t" r)))
            (println "  first 8 by rank:")
            (doseq [h (take 8 ranked)] (println (fmt-hit h)))
            (println (str "  narrow: find " (first leafs) " --in <repo-path>"
                          (when-not exact? (str "  |  find " (first leafs) " --exact"))
                          "  |  find <ns>/" (first leafs)))))
        ;; hit が 3 件以下なら show を待たずに全部の snippet を出す (round trip を 1 つ減らす。
        ;; iteration 2 は 1 件のときだけだった; Hermes A/B では全 query が 2 call だった)
        ;; iteration 9: 合計でなく **exact hit** が 1-3 件なら exact の snippet を出す。substring
        ;; hit (kernel-base → kernel-base-positions …) が混ざって合計 >3 になり、agent が
        ;; show をもう 1 回呼ぶ形が one_call bench で 3/8 あった
        (let [pick (cond (<= 1 (count exact) 3) exact
                         (<= 1 n 3) ranked
                         :else nil)]
          (doseq [{:keys [file line sym kind]} pick]
            (when (> n 1) (println (str "== " kind " " sym " — " file ":" line)))
            (println (snippet file line))))
        (when (zero? n) (suggest-near text (first leafs) keep?))
        (if (seq hits) 0 1)))))

(defn- cmd-show
  "`sym` / `ns/sym` / `sym:line` を受ける。ns が付いていれば ns 列で絞り、絞って
  0 件なら leaf だけで引き直す (その旨を印字)。"
  [target]
  (let [{:keys [text error]} (load-index-text)]
    (if error
      (refuse error)
      (let [[sym-part] (str/split target #":")
            slash (.lastIndexOf sym-part "/")
            ns-part (when (pos? slash) (subs sym-part 0 slash))
            leaf (if (pos? slash) (subs sym-part (inc slash)) sym-part)
            all (scan-rows text (escape-re leaf) "")
            in-ns (when ns-part (filter #(= (:ns %) ns-part) all))
            hits (cond (seq in-ns) in-ns
                       (and ns-part (seq all))
                       (do (println (str "no " leaf " in ns " ns-part " — showing " leaf " from other ns")) all)
                       :else all)
            hits (sort-by #(rank-key (str/lower-case leaf) %) hits)]
        (if (empty? hits)
          (refuse "no exact match for " target " — try: find " leaf)
          (do
            (doseq [{:keys [file line sym kind ns]} (take 3 hits)]
              (println (str "== " kind " " (if (seq ns) (str ns "/") "") sym " — " file ":" line))
              (println (snippet file line)))
            (when (> (count hits) 3)
              (println (str "  ... " (- (count hits) 3) " more definitions of " leaf " (qualify with ns/)")))
            0))))))

(defn- signature
  "def 行の名前より後ろ (arglist か本体の先頭) を 1 行に。無ければ次行が docstring なら
  その 1 行目。iteration 10 の実測 (defn 600 件): arglist は 55% が def 行、40% は
  docstring が先 (arglist はその後)。どちらでも 1 行で『何を取るか / 何をするか』が
  分かるので、agent が outline の後に Read へ行く理由を減らす。80 字で切る。"
  [lines line sym]
  (let [l (nth lines (dec line) "")
        i (.indexOf l sym)
        rest (if (neg? i) "" (str/trim (subs l (+ i (count sym)))))
        rest (str/replace rest #"\)+$" "")
        nxt (str/trim (nth lines line ""))
        sig (cond (seq rest) rest
                  (str/starts-with? nxt "\"") (str/replace nxt #"^\"|\"$" "")
                  (str/starts-with? nxt "[") nxt
                  :else "")
        sig (str/replace sig #"\s+" " ")]
    (if (> (count sig) 80) (str (subs sig 0 79) "…") sig)))

(defn- cmd-outline
  "file (path の末尾一致) か ns (完全一致) の定義を行順に並べる。file を Read する
  前の地図: 1 行 ≈ 10 tok なので 100 def の file でも ~1k tok で済む。
  iteration 10: 各行に signature (arglist か docstring 1 行目) を添える。--bare で消す。"
  [target opts]
  (let [{:keys [header text error]} (load-index-text)]
    (if error
      (refuse error)
      (let [by-path? (or (str/includes? target "/") (re-find #"\.(cljk|cljc|cljs|clj|kotoba)$" target))
            rows (if by-path?
                   (let [re (js/RegExp. (str "^[^\t\n]*\t[^\t\n]*\t[^\t\n]*" (escape-re target) "\t[^\n]*$") "gm")
                         out (volatile! [])]
                     (loop [] (when-let [m (.exec re text)] (vswap! out conj (parse-row (aget m 0))) (recur)))
                     @out)
                   (let [re (js/RegExp. (str "^[^\t\n]*\t[^\t\n]*\t[^\t\n]*\t\\d+\t" (escape-re target) "\t[^\n]*$") "gm")
                         out (volatile! [])]
                     (loop [] (when-let [m (.exec re text)] (vswap! out conj (parse-row (aget m 0))) (recur)))
                     @out))
            files (distinct (map :file rows))]
        (if (empty? rows)
          (refuse "no definitions for " target " — try: find " (last (str/split target #"[/.]")))
          (do
            (age-warning header)
            (doseq [f (take 5 files)]
              (println (str "== " f))
              (let [lines (when-not (:bare opts)
                            (try (str/split-lines (.readFileSync fs (.join path top f) "utf8")) (catch :default _ nil)))]
                (doseq [{:keys [line kind sym nested]} (sort-by :line (filter #(= f (:file %)) rows))]
                  (let [sig (when lines (signature lines line sym))]
                    (println (str "  " line "\t" (if nested "~" "") kind " " sym
                                  (when (seq sig) (str "  · " sig))))))))
            (when (> (count files) 5)
              (println (str "  ... " (- (count files) 5) " more files match " target " (give a longer path)")))
            0))))))

(defn- cmd-status
  "索引の素性を印字する。dead code だった iteration 1 の index-stale? の代わり:
  鮮度は自動判定せず built-at と age を見せ、判断を人に返す。"
  []
  (let [p (index-path)]
    (if-not (.existsSync fs p)
      (refuse "no index at " p " — run build")
      (let [text (.readFileSync fs p "utf8")
            h (parse-header text)]
        (if (nil? h)
          (refuse "index is not v2 TSV (stale JSON?) — run build")
          (let [age-min (js/Math.round (/ (- (.getTime (js/Date.)) (.getTime (js/Date. (:built-at h)))) 60000))]
            (doseq [[k v] (sort-by key h)]
              (if (= k :pruned-groups)
                (doseq [g (remove str/blank? (str/split v #";"))]
                  (println (str "pruned-group\t" g)))
                (println (str (name k) "\t" v))))
            (println (str "age-minutes\t" age-min))
            (println (str "bytes\t" (.-size (.statSync fs p))))
            (if (not= (:top h) top)
              (refuse "index top=" (:top h) " differs from cwd top=" top)
              0)))))))

(defn- script-args
  "nbb / kbb どちらでも *command-line-args* が空のことがあるため
  gen-west-manifest.cljs / repo-search.cljk と同じ復元を行う。"
  []
  (if (seq *command-line-args*)
    *command-line-args*
    (let [argv (vec (js->clj (.-argv js/process)))
          index (first (keep-indexed
                        (fn [i value]
                          (when (str/ends-with? value "scripts/symbol-index.cljk") i))
                        argv))]
      (if (some? index) (subvec argv (inc index)) []))))

(defn- usage []
  (println "usage: kbb --backend sci scripts/symbol-index.cljk build|find|show|outline|status [args]")
  (println "  build [--include-worktrees] [--no-prune] [--full] — scan .cljk/.cljc/.cljs/.clj/.kotoba and write the index")
  (println "  find <term|ns/term> [term...] [--in <path-substr>] [--exact] — symbol name search (exit 1 = 0 hits)")
  (println "  show <symbol|ns/symbol> — definition snippet (file:line + context lines)")
  (println "  outline <file-suffix|ns> [--bare] — every definition in a file/namespace with its signature (map before Read)")
  (println "  status — index header (top / built-at / scanned / symbols) and age")
  2)

(defn -main [& args]
  (let [[cmd & rest-args] args]
    (cond
      (= cmd "build")
      (do-build {:include-worktrees (some #{"--include-worktrees"} rest-args)
                 :no-prune (some #{"--no-prune"} rest-args)
                 :full (some #{"--full"} rest-args)})

      (= cmd "find")
      (if (empty? rest-args)
        (refuse "find needs at least one term")
        (cmd-find rest-args))

      (= cmd "show")
      (if (empty? rest-args)
        (refuse "show needs a symbol (e.g. kagami.db/apply-pin-advance)")
        (cmd-show (first rest-args)))

      (= cmd "outline")
      (let [targets (remove #{"--bare"} rest-args)]
        (if (empty? targets)
          (refuse "outline needs a file suffix or a namespace (e.g. kagami/db.cljk or kagami.db)")
          (cmd-outline (first targets) {:bare (some #{"--bare"} rest-args)})))

      (= cmd "status")
      (cmd-status)

      :else
      (usage))))

(let [args (script-args)]
  (if (seq args)
    (let [code (apply -main args)]
      (.exit js/process (if (number? code) code 0)))
    (do (usage)
        (.exit js/process 2))))
