 {:iteration 6 :id :h19-kotoba-find
  :date "2026-09-15"
  :question "オーナー指示: kotoba-lang の find / grep (org-ieee-find / org-ieee-grep) で walk を速くできるか"
  :evaluated {:org-ieee-find "0a9916a" :org-ieee-grep "5f12337" :amu "73ddd261"
              :how "amu compile find/core.kotoba --target aarch64-macos --jvm-free → extract-native → package-command.cljk (--fs-scope/--browse-scope = 対象 dir)"}
  :measured {:kagami {:entries 367 :kotoba-find-s 0.50 :usr-bin-find-s 0.14 :set-identical true}
             :amu {:entries 8719 :kotoba-find-s 0.67 :usr-bin-find-s 0.12 :files {:kotoba 8166 :usr-bin 8161}}
             :app-news {:entries 34803 :kotoba-find "KEXE_TRAP SIGILL after 7,272 files" :usr-bin-find-s 1.98}
