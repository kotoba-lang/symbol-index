 {:iteration 2 :id :h3-query-latency
  :date "2026-09-15"
  :observation "find / show が毎回 108 MB JSON を parse し 780K map を js->clj する"
  :fix "TSV v2 + native RegExp 走査。SCI の per-line loop を回さない"
  :before {:find-wall-s 5.85 :show-wall-s 5.18 :index-bytes 108449364 :symbols 779522}
  :after {:find-wall-s 0.76 :show-wall-s 0.64 :index-bytes 73854996 :symbols 612791
          :find-wall-s-samples [0.73 0.76 0.78]}
  :ratio 7.7
  :note "kbb 起動が 0.49 s なので下限はそこ"
  :verdict :landed}

 {:iteration 2 :id :h4-stale-claim
  :date "2026-09-15"
  :observation "header comment に『stale 判定は行数 + 最新 mtime』とあるが index-stale? はどこからも呼ばれない dead code"
  :fix "虚偽の claim を消し、status コマンドで built-at / age / scanned / symbols を見せる。find/show は 24 h 超で 1 行警告 (自動 rebuild はしない)"
  :verdict :landed}

 {:iteration 2 :id :h5-exit-semantics
  :date "2026-09-15"
  :observation "0 symbols の索引でも find は『0 hits』exit 0。空 tree の build も exit 0 で空索引を書く (8 問の Q1/Q4)"
  :fix "exit 0 = hit / 1 = 測って 0 件 / 2 = 拒否。scanned 0 の build は REFUSE、top 不一致・旧形式・0 symbols も REFUSE"
  :verdict :landed}

 {:iteration 2 :id :h6-worktree-and-generated-noise
  :date "2026-09-15"
  :observation "linked worktree (_wt-* / .claude/worktrees/*) と gitignore された生成物 dir (runs/ 32,025 / verify-runs/ 27,492 symbol) が索引に載る"
  :fix "gitfile が /worktrees/ を指す dir は skip (--include-worktrees で戻す)。top 直下の gitignored かつ .git 無しの dir は skip"
  :measured {:check-ignore-depth-1-s 0.85 :check-ignore-depth-2-s 29.9 :decision "depth 1 のみ"}
  :after {:skipped-worktrees 34 :skipped-gitignored 22 :scanned 51594}
  :verdict :landed}

 {:iteration 2 :id :h7-nested-defs
